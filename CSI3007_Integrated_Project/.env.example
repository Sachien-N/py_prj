# CSI3007 Integrated Project - repository-level configuration (optional).
# Copy to .env and adjust. Individual projects keep their OWN .env files:
# see person_*/.env.example for the per-project templates.

# Integration gateway port (central landing page)
GATEWAY_PORT=8000

# Health-check behaviour for the gateway and launcher
HEALTH_TIMEOUT_SECONDS=2
STARTUP_TIMEOUT_SECONDS=60

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
