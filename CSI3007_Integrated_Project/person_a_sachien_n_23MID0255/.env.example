# Person A — local development configuration
# Copy to .env and change the integration keys before sharing the project.

DATABASE_URL=sqlite:///./data/person_a.db
API_HOST=127.0.0.1
API_PORT=8001
API_BASE_URL=http://127.0.0.1:8001

# Where Person A can pull data from during a manual sync.
PERSON_B_API_URL=http://127.0.0.1:8002
PERSON_C_API_URL=http://127.0.0.1:8003

# Shared development secrets; must match Person B and Person C respectively.
PERSON_B_SYNC_API_KEY=dev-person-b-to-a-key
PERSON_C_SYNC_API_KEY=dev-person-c-to-a-key

INTEGRATION_TIMEOUT_SECONDS=5
INTEGRATION_RETRIES=2
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
