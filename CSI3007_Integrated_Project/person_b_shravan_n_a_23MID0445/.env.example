# Person B — local development configuration
# Copy to .env and change the integration key before sharing the project.

DATABASE_URL=sqlite:///./data/person_b.db
API_HOST=127.0.0.1
API_PORT=8002
API_BASE_URL=http://127.0.0.1:8002

PERSON_A_API_URL=http://127.0.0.1:8001
# Must match PERSON_B_SYNC_API_KEY in Person A's .env.
PERSON_A_SYNC_API_KEY=dev-person-b-to-a-key

INTEGRATION_TIMEOUT_SECONDS=5
INTEGRATION_RETRIES=2
UPCOMING_DAYS=30
CORS_ORIGINS=http://127.0.0.1:8502,http://localhost:8502
