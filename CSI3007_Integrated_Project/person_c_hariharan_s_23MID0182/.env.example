# Person C — local development configuration
# Copy to .env before sharing/deploying this project.

DATABASE_URL=sqlite:///./data/person_c.db
API_HOST=127.0.0.1
API_PORT=8003
API_BASE_URL=http://127.0.0.1:8003
TIMEZONE=Asia/Kolkata

PERSON_A_API_URL=http://127.0.0.1:8001
# Must match PERSON_C_SYNC_API_KEY in Person A's .env.
PERSON_A_SYNC_API_KEY=dev-person-c-to-a-key

INTEGRATION_TIMEOUT_SECONDS=5
INTEGRATION_RETRIES=2
DISCREPANCY_TOLERANCE_PERCENT=10
MAX_READING_GAP_HOURS=4
CORS_ORIGINS=http://127.0.0.1:8503,http://localhost:8503
